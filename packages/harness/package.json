{
  "name": "@deck-monsters/harness",
  "version": "0.1.0",
  "description": "Local simulation harness for Deck Monsters — CLI scripts and extended integration scenarios",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha --exit",
    "run": "tsx src/cli-entry.ts",
    "simulate": "tsx src/cli-entry.ts simulate",
    "sim:winrates": "node dist/scripts/sim-winrates.js",
    "sim:cardpower": "node dist/scripts/sim-cardpower.js",
    "sim:levelscaling": "node dist/scripts/sim-levelscaling.js",
    "sim:economy": "node dist/scripts/sim-economy.js",
    "sim:monster": "node dist/scripts/sim-monster.js",
    "sim:bosses": "node dist/scripts/sim-bosses.js",
    "sim:rings": "node dist/scripts/sim-rings.js",
    "sim:mega": "node dist/scripts/sim-mega.js",
    "sim:statcards": "node dist/scripts/sim-statcards.js",
    "sim:batch": "node dist/scripts/sim-batch.js",
    "sim:report": "node dist/scripts/sim-report.js",
    "plan:curves": "node dist/scripts/plan-curves.js",
    "plan:ladder": "node dist/scripts/plan-ladder.js",
    "plan:validate-he": "node dist/scripts/plan-validate-he.js",
    "sim:validate-he": "node dist/scripts/sim-validate-he.js",
    "plan:catalogue": "node dist/scripts/plan-catalogue.js",
    "sim:catalogue": "node dist/scripts/sim-catalogue.js",
    "sim:formula": "node dist/scripts/sim-formula.js",
    "sim:unicorn": "node dist/scripts/sim-monster.js Unicorn"
  },
  "dependencies": {
    "@deck-monsters/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.6.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.4",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
